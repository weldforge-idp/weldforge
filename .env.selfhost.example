# WeldForge self-host configuration. Copy to ".env" and fill in.
#   cp .env.selfhost.example .env
# Used by docker-compose.selfhost.yml. NEVER commit a real .env.
#
# If you are a recipient of this repo's SOPS key, you do not need to fill this in
# by hand — the values are already committed, encrypted:
#   ./scripts/secrets.sh env selfhost      # writes .env (gitignored)
# See docs/secrets-sops.md. This example file remains the starting point for
# anyone running their own instance with their own secrets.

# --- Database ---
DB_NAME=weldforge
DB_USERNAME=weldforge
# openssl rand -base64 24
DB_PASSWORD=

# --- Required secrets (the app refuses to boot without strong values) ---
# JWT signing key — MUST be >= 64 bytes:   openssl rand -base64 64
JWT_SECRET=
# At-rest encryption key — MUST be >= 16 chars:   openssl rand -base64 32
# Set once and DO NOT change after first run (it encrypts stored secrets).
APP_CRYPTO_SECRET=

# Refuse to boot on placeholder/dev secrets (recommended: true).
APP_REQUIRE_SECURE_SECRETS=true

# --- First super-admin bootstrap ---
# Register this email in the app first, then set it here and restart; the user
# is promoted to super-admin on boot. Unset it again afterwards (see
# docs/runbooks/production-bootstrap.md §7).
WF_BOOTSTRAP_ADMIN_EMAIL=

# --- Public host (for real deployments behind a domain + HTTPS) ---
# For a localhost eval, leave these as-is.
WF_BASE_DOMAIN=localhost
WF_SCHEME=http
# WebAuthn/passkeys — override to your real host or passkeys break off-localhost.
WF_WEBAUTHN_RP_ID=localhost
WF_WEBAUTHN_ORIGINS=http://localhost:8080
