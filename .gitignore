target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# https://maven.apache.org/wrapper/#usage-without-binary-jar
.mvn/wrapper/maven-wrapper.jar

# Eclipse m2e generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Node / Angular
node_modules/
dist/
.angular/
coverage/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Claude Code session data
.claude/

# Local junk that should never be committed
*.pkg
files.zip
AWSCLIV2.pkg
*.swp
*~

# Local dev env files — only .env.example should be committed
.env
.env.local
.env.*.local
weldforge-auth/.env
weldforge-admin-portal/.env

# Local secrets / API tokens — never commit
.wf-token
*.token

# SOPS + age. Files under infrastructure/secrets/ named *.enc.yaml / *.enc.env
# are ENCRYPTED and SHOULD be committed — that is the whole point. What must
# never be committed is anything decrypted from them, or an age private key.
*.dec.yaml
*.dec.env
*.dec.json
age-key.txt
keys.txt
*.agekey

# Test output
test-output/

# Terraform — .terraform/ contains downloaded provider binaries (can be 100s of MB)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl should be committed
crash.log
crash.*.log
RESUME.md
