<?xml version="1.0" encoding="UTF-8"?>
<!--
  WeldForge logging configuration (Log4j 2).

  Replaces the previous Logback configuration. SLF4J remains the facade used
  by every call site, so nothing in application code changed: only the binding
  and this file did.

  Two output formats depending on the active Spring profile:
  - default / dev / local: human-readable console with MDC inline
  - prod / json: single-line JSON for ingestion into ELK / Datadog /
    CloudWatch / any SIEM that parses structured logs

  Every log line carries MDC keys populated by MdcEnrichmentFilter:
    request_id   - per-request correlation id
    tenant       - current tenant slug (post-auth or resolver default)
    actor        - authenticated user email, if any
    super_admin  - "true" for super-admin calls

  Security incidents go to the logger named "security.audit", written by
  AuditService, so a downstream pipeline can split them from noisy HTTP
  access logs. Under the JSON layout the audit fields arrive as real fields,
  because AuditService puts them in the MDC and the template flattens it.

  Profile selection uses Spring Boot's SpringProfile arbiter, which is why
  this file must be named log4j2-spring.xml rather than log4j2.xml: Log4j
  loads the latter itself, before Spring exists, and the arbiter would then
  have no profiles to match against.
-->
<Configuration status="WARN">

    <Properties>
        <Property name="CONSOLE_PATTERN">%d{HH:mm:ss.SSS} %highlight{%-5level} [%t] %style{%logger{36}}{cyan} [req=%X{request_id:-} tenant=%X{tenant:-} actor=%X{actor:-}] %msg%n%throwable</Property>
    </Properties>

    <Appenders>
        <!-- ==== Pretty console (dev) ============================== -->
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}"/>
        </Console>

        <!-- ==== JSON (prod / SIEM) ================================ -->
        <Console name="JSON" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Sensible defaults, unchanged from the Logback configuration. -->
        <Logger name="org.springframework.security" level="INFO"/>
        <Logger name="org.hibernate.SQL" level="WARN"/>
        <Logger name="tech.cwvermaak.weldforge" level="DEBUG"/>
        <Logger name="security.audit" level="INFO"/>

        <!-- Profile-scoped root: JSON in prod, console everywhere else. -->
        <Root level="INFO">
            <SpringProfile name="prod | json">
                <AppenderRef ref="JSON"/>
            </SpringProfile>
            <SpringProfile name="!prod &amp; !json">
                <AppenderRef ref="CONSOLE"/>
            </SpringProfile>
        </Root>
    </Loggers>

</Configuration>
