# ============================================================
# Fast variant: assumes the JAR has been built locally with
# `mvn package -DskipTests`. Use this for iteration; the
# main Dockerfile is the canonical reproducible build.
# ============================================================
FROM bellsoft/liberica-openjre-debian:25

LABEL org.opencontainers.image.source="https://github.com/weldforge-idp/weldforge"

RUN groupadd -r sso && useradd -r -g sso -d /app -s /sbin/nologin sso
WORKDIR /app

COPY target/weldforge-auth-*.jar app.jar
RUN chown -R sso:sso /app

USER sso
EXPOSE 8076

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -sf http://localhost:8076/actuator/health/liveness || exit 1

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
